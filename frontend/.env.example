# ---------------------------------------------------------------------------
# KAS frontend environment. Copy to .env.local for development.
# .env.local is git-ignored; .env.example is not, and must never hold a secret.
# ---------------------------------------------------------------------------

# Origin of the Spring Boot backend. SERVER-SIDE ONLY — never exposed to the
# browser, because the browser must always talk to the frontend origin and let
# next.config.ts rewrites() forward the request (see next.config.ts).
# Spring Boot's default port; no server.port is set in application.yml.
KAS_API_ORIGIN=http://localhost:8080

# Default locale when a visitor presents no signal. Doc 22 §3 prefixes every
# customer route with a locale.
# NOTE: the backend registers DEFAULT_LOCALE as business config A11 / OQ-065 and
# it is still NULL. This value is a routing fallback for the frontend only and
# carries no business meaning.
NEXT_PUBLIC_DEFAULT_LOCALE=en

# Next.js collects anonymous build telemetry by default. This project sends nothing
# outbound that it has not decided to send, so it is disabled explicitly rather than
# left to a per-machine global setting.
NEXT_TELEMETRY_DISABLED=1
